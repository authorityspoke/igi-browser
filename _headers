# Netlify cache rules (GitHub Pages ignores this file). Fingerprinted _framework
# files are immutable; the landing page must always revalidate so a new deploy
# shows at once. NOTE: Netlify does not serve the on-disk .br/.gz files by
# content negotiation; it compresses at the edge instead.
/_framework/*
  Cache-Control: public, max-age=31536000, immutable
/index.html
  Cache-Control: no-cache
/main.js
  Cache-Control: no-cache
/platform.js
  Cache-Control: no-cache
